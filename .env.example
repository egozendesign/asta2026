# 21st.dev Magic MCP — chiave API letta da .mcp.json come ${TWENTYFIRST_API_KEY}
#
# NON committare la key vera. Questo file (.env.example) e' solo un modello.
# Copia questo file in .env (che e' gia' in .gitignore) e inserisci la tua key,
# oppure esporta la variabile nel tuo shell prima di avviare Claude Code:
#
#   export TWENTYFIRST_API_KEY=la_tua_key
#
TWENTYFIRST_API_KEY=
